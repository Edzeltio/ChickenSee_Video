[Unit]
Description=ChickenSee Edge AI Vision & Sensor Telemetry Pipeline
After=network.target network-online.target

[Service]
Type=simple
User=chickensee
WorkingDirectory=/opt/chickensee
ExecStart=/usr/bin/python3 -m edge.pipeline
Restart=always
RestartSec=5s

# Environment variables
Environment=PYTHONUNBUFFERED=1
Environment=INFERENCE_DEVICE=auto
EnvironmentFile=-/etc/chickensee/edge.env
Environment=TRACKER_CONFIG=/opt/chickensee/bytetrack_poultry.yaml
Environment=DB_PATH=/opt/chickensee/agent/data/chicken_telemetry.db
Environment=START_HOUR=6
Environment=END_HOUR=18

# Logging to system journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chickensee-edge

[Install]
WantedBy=multi-user.target
